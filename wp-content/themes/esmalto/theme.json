{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "fondo", "name": "Fondo", "color": "#002100" },
				{ "slug": "fondo-oscuro", "name": "Fondo oscuro (pie)", "color": "#001a00" },
				{ "slug": "superficie", "name": "Superficie", "color": "#00330f" },
				{ "slug": "panel", "name": "Panel verde", "color": "#154734" },
				{ "slug": "acento", "name": "Amarillo Esmalto", "color": "#fec30c" },
				{ "slug": "acento-claro", "name": "Amarillo claro", "color": "#ffd75c" },
				{ "slug": "ocre", "name": "Ocre", "color": "#917300" },
				{ "slug": "texto", "name": "Texto", "color": "#f1f1f1" },
				{ "slug": "texto-suave", "name": "Texto suave", "color": "#c8d2c8" },
				{ "slug": "texto-apagado", "name": "Texto apagado", "color": "#a9b5a9" },
				{ "slug": "texto-tenue", "name": "Texto tenue", "color": "#8a968a" },
				{ "slug": "texto-mudo", "name": "Texto mudo", "color": "#7c877c" },
				{ "slug": "tinta", "name": "Tinta (sobre amarillo)", "color": "#181818" },
				{ "slug": "blanco", "name": "Blanco", "color": "#ffffff" }
			],
			"gradients": [
				{ "slug": "hero", "name": "Velo portada", "gradient": "linear-gradient(90deg,rgba(0,26,0,0.94) 0%,rgba(0,26,0,0.72) 42%,rgba(0,26,0,0.18) 78%,rgba(0,26,0,0.5) 100%)" },
				{ "slug": "tarjeta", "name": "Velo tarjeta", "gradient": "linear-gradient(180deg,rgba(0,17,0,0) 40%,rgba(0,17,0,0.92) 100%)" },
				{ "slug": "profesional", "name": "Velo profesional", "gradient": "linear-gradient(90deg,rgba(0,26,0,0.96) 0%,rgba(0,26,0,0.74) 100%)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{ "slug": "titulos", "name": "Playfair Display (títulos)", "fontFamily": "'Playfair Display', Georgia, 'Times New Roman', serif" },
				{ "slug": "texto", "name": "Montserrat (texto)", "fontFamily": "Montserrat, 'Helvetica Neue', Arial, sans-serif" },
				{ "slug": "mono", "name": "Courier (etiquetas)", "fontFamily": "'Courier New', Courier, monospace" }
			],
			"fontSizes": [
				{ "slug": "xxs", "name": "Etiqueta", "size": "11px" },
				{ "slug": "xs", "name": "Pequeño", "size": "12px" },
				{ "slug": "sm", "name": "Nota", "size": "13px" },
				{ "slug": "base", "name": "Base", "size": "15px" },
				{ "slug": "md", "name": "Medio", "size": "16px" },
				{ "slug": "lg", "name": "Grande", "size": "clamp(20px, 2.4vw, 26px)" },
				{ "slug": "xl", "name": "Título 3", "size": "clamp(24px, 3vw, 32px)" },
				{ "slug": "xxl", "name": "Título sección", "size": "clamp(26px, 3.4vw, 44px)" },
				{ "slug": "display", "name": "Título página", "size": "clamp(28px, 4vw, 56px)" },
				{ "slug": "hero", "name": "Portada", "size": "clamp(34px, 5.4vw, 74px)" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "8px" },
				{ "slug": "20", "name": "S", "size": "14px" },
				{ "slug": "30", "name": "M", "size": "22px" },
				{ "slug": "40", "name": "L", "size": "36px" },
				{ "slug": "50", "name": "XL", "size": "clamp(48px, 7vw, 80px)" },
				{ "slug": "60", "name": "Sección", "size": "clamp(56px, 8vw, 96px)" },
				{ "slug": "70", "name": "Sección amplia", "size": "clamp(60px, 9vw, 110px)" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"margen": "clamp(16px, 4vw, 40px)",
			"borde": {
				"sutil": "rgba(255, 255, 255, 0.08)",
				"suave": "rgba(255, 255, 255, 0.12)",
				"medio": "rgba(255, 255, 255, 0.16)",
				"fuerte": "rgba(255, 255, 255, 0.3)"
			},
			"tracking": {
				"etiqueta": "0.3em",
				"boton": "0.16em",
				"menu": "0.08em"
			}
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--fondo)",
			"text": "var(--wp--preset--color--texto)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--texto)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "22px"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--acento)" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var(--wp--preset--color--acento-claro)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--texto)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titulos)",
					"fontWeight": "500",
					"lineHeight": "1.1"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--md)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--md)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--base)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--acento)",
					"text": "var(--wp--preset--color--tinta)"
				},
				"border": { "radius": "0", "width": "0" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--texto)",
					"fontSize": "var(--wp--preset--font-size--xs)",
					"fontWeight": "500",
					"letterSpacing": "0.16em",
					"textTransform": "uppercase",
					"lineHeight": "1.3"
				},
				"spacing": { "padding": { "top": "15px", "right": "28px", "bottom": "15px", "left": "28px" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--acento-claro)",
						"text": "var(--wp--preset--color--tinta)"
					}
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--acento-claro)", "offset": "2px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--texto-tenue)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--xs)" }
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": { "fontWeight": "300" }
			},
			"core/list": {
				"typography": { "fontWeight": "300" }
			},
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--texto)"
						},
						"border": {
							"color": "rgba(255, 255, 255, 0.4)",
							"style": "solid",
							"width": "1px"
						},
						"spacing": { "padding": { "top": "14px", "right": "27px", "bottom": "14px", "left": "27px" } }
					}
				}
			},
			"core/separator": {
				"color": { "text": "rgba(255, 255, 255, 0.12)" },
				"border": { "width": "1px 0 0 0" }
			},
			"core/details": {
				"border": {
					"bottom": { "color": "rgba(255, 255, 255, 0.1)", "style": "solid", "width": "1px" }
				},
				"spacing": { "padding": { "top": "20px", "bottom": "20px" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--md)" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var(--wp--preset--color--acento)", "style": "solid", "width": "2px" }
				},
				"spacing": { "padding": { "left": "22px" } }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--titulos)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie", "area": "footer" }
	],
	"patterns": []
}
